  "spec": {
    "inputs": [
      {
        "group": "composition",
        "label": "Composition statistics",
        "n": 33,
        "detail": "mean, spread, min and max of 8 element properties, plus the number of elements"
      },
      {
        "group": "structure",
        "label": "Measurable crystal structure",
        "n": 17,
        "items": [
          {
            "name": "crystal system and lattice centring",
            "why": "seven crystal systems and four centring types, one-hot"
          },
          {
            "name": "pg_order",
            "why": "order of the point group, a single number for how symmetric the crystal is"
          },
          {
            "name": "vpa",
            "why": "volume per atom"
          },
          {
            "name": "density",
            "why": "density from the composition and the volume per atom"
          },
          {
            "name": "aniso",
            "why": "longest over geometric mean of the two shorter reduced-cell edges, a measure of layering"
          },
          {
            "name": "c_over_a",
            "why": "c/a of the conventional cell for tetragonal and hexagonal crystals (1 for cubic)"
          },
          {
            "name": "f_spacing",
            "why": "volume per f-electron atom to the power 1/3, a proxy for the f-f distance that decides whether f electrons stay local (the Hill limit)"
          }
        ]
      },
      {
        "group": "physics",
        "label": "Physics features proposed by the AI",
        "n": 15,
        "items": [
          {
            "name": "tm_d",
            "why": "d electrons per transition-metal atom from charge balance (Cu2+ is d9, Fe2+ d6, Ni+ d9); each family's parent compound sits at a characteristic filling and doping moves it away"
          },
          {
            "name": "p_cu",
            "why": "holes per Cu from charge balance (negative for electron doping); cuprate Tc rises and falls with it"
          },
          {
            "name": "dome",
            "why": "the empirical cuprate dome 1 - 82.6 (p - 0.16)^2 (Presland and Tallon), largest at p = 0.16"
          },
          {
            "name": "cu_layers",
            "why": "Cu atoms per formula unit, a proxy for the number of CuO2 planes; Tc rises from one to three planes"
          },
          {
            "name": "heavy_block",
            "why": "share of Hg, Tl, Bi and Pb, the heavy-metal charge reservoirs of the highest-Tc cuprates"
          },
          {
            "name": "fe_based",
            "why": "iron or nickel together with a pnictogen or chalcogen, the FeAs- or FeSe-type layer"
          },
          {
            "name": "f_share",
            "why": "share of atoms with a partly filled f shell (Ce, Yb, U, Pu and others), the local moments of heavy-fermion metals"
          },
          {
            "name": "f_count",
            "why": "nominal f-electron count of those atoms"
          },
          {
            "name": "mag3d",
            "why": "share of magnetic 3d atoms (V to Cu), a proxy for spin fluctuations"
          },
          {
            "name": "nonint",
            "why": "share of non-integer stoichiometry, which marks doped samples"
          },
          {
            "name": "n_atoms_fu",
            "why": "atoms per formula unit as written, a measure of chemical complexity"
          },
          {
            "name": "oxide",
            "why": "share of oxygen"
          },
          {
            "name": "chalcogenide",
            "why": "share of S, Se and Te"
          },
          {
            "name": "pnictide",
            "why": "share of P, As and Sb"
          },
          {
            "name": "halide",
            "why": "share of F, Cl, Br and I"
          }
        ]
      },
      {
        "group": "elements",
        "label": "Element fractions",
        "n": 79,
        "detail": "the share of each element seen in at least ten training compounds"
      }
    ],
    "learner": {
      "kind": "gradient-boosting classifier",
      "trees": 400,
      "leaves": 31,
      "learning_rate": 0.05,
      "min_leaf": 10,
      "l2": 1.0,
      "features_per_split": 1.0,
      "ensemble": 1,
      "loss": "log loss",
      "weights": null,
      "calibration": null
    },
    "target": "probability that the material belongs to an unconventional family",
    "cv": "5-fold, grouped by parent compound (the Materials Project chemical system)",
    "rule": "send to Hurricane if the probability is at least 0.5, otherwise to Storm"
  },
