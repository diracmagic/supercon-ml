  "version": "2.0",
  "designer": "AI agent (Claude) proposed the candidates: phonon-scale features, an Allen-Dynes stage, a median objective and a seed average, with a measured-Tc check graded by reliability",
  "design": "Round 2 builds on Storm 1.0. The latest experiments still support phonon-mediated pairing in the light-element, high-frequency materials (the 2025 H3S tunnelling gap and its isotope shift), so the agent added phonon-frequency scales from measured element data (melting point, speed of sound, bulk modulus), an Allen-Dynes stage that feeds predicted lambda and omega_log into the Tc model, and a median objective that matches the reported absolute error. Every candidate is also checked against measured Tc graded by reliability: only replicated, ambient-pressure, phonon-mediated superconductors are scored, single reports and preprints are shown but not scored, and retracted or refuted claims are left out. DFT is not assumed right either: the check also reports how far the DFT training labels themselves are from experiment.",
  "selection": "5-fold GroupKFold by chemical system on Alexandria (7,582 materials); the locked JARVIS test set is not used",
  "rule": "release the lowest-error design that beats Storm 1.0 on average and in at least 4 of 5 folds and is not more than 0.5 K worse on replicated measured Tc; otherwise the best design stays experimental",
  "caveat": "picking the best of several candidates on the same folds makes its score slightly optimistic; the locked JARVIS test set will check the final model once",
  "scikit_learn": "1.9.1",
  "physics_features": {
    "vec": "valence electrons per atom; Matthias found Tc peaks near 4.7 and 6.5 in transition-metal compounds",
    "matthias_d47": "distance of the valence-electron count from the first Matthias peak (4.7)",
    "matthias_d65": "distance from the second Matthias peak (6.5)",
    "d_fraction": "share of d-block atoms, a proxy for a high density of states at the Fermi level",
    "p_fraction": "share of p-block atoms (covalent bonding, as in MgB2 and the A15 compounds)",
    "light_fraction": "share of light atoms (Z <= 9), which vibrate at high frequency",
    "inv_sqrt_mass": "composition average of M^-1/2; phonon frequencies scale like M^-1/2 (isotope effect)",
    "omega_proxy": "M^-1/2 divided by the mean nearest-neighbour distance, a crude stiffness-over-mass frequency scale",
    "mass_ratio": "heaviest over lightest atomic mass; light atoms in a heavy matrix give separate optical modes",
    "x_diff": "electronegativity difference, a proxy for ionicity and charge transfer",
    "packing_fraction": "atomic-sphere volume over volume per atom, a proxy for how compressed the lattice is"
  },
  "phonon_features": {
    "theta_lindemann": "Lindemann estimate of the Debye temperature, sqrt(Tm / (M V^2/3)) from each element's melting point, mass and the crystal's volume per atom, averaged over the composition",
    "theta_lindemann_min": "the same Lindemann scale for the softest element, which sets the low-frequency phonons",
    "sound_omega": "composition-averaged elemental speed of sound over the mean nearest-neighbour distance, a Debye-frequency proxy",
    "bulk_mean": "composition-averaged elemental bulk modulus, a lattice-stiffness proxy",
    "omega_bulk": "sqrt(bulk modulus x nearest-neighbour distance / mass), a stiffness-over-mass frequency"
  },
