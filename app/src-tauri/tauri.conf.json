{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Supercon Progress",
  "version": "0.3.8",
  "identifier": "io.github.diracmagic.supercon-progress",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Supercon Progress",
        "width": 1180,
        "height": 860,
        "minWidth": 420,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "diracmagic",
    "category": "Education",
    "shortDescription": "Live progress of the supercon-ml project",
    "longDescription": "Shows the stages, training results and GitHub Actions runs of supercon-ml, a project that looks for high-Tc superconductors with AI-designed models.",
    "resources": ["THIRD-PARTY-NOTICES.txt"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    },
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
