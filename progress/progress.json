  "ai_model": {
    "name": "Storm",
    "about": "Storm is the project's AI-designed Tc model for conventional, phonon-mediated superconductors; it is trained on DFT electron-phonon data, so it does not cover cuprates, nickelates, iron-based or other unconventional superconductors, which are planned for a separate model, Hurricane. An AI agent (Claude) proposes each design; every candidate is trained and scored with the same composition-grouped cross-validation, and a new version is released only if it beats the current best on average and in at least 4 of the 5 folds, and does not do clearly worse on replicated measured Tc.",
    "current": "1.0",
    "versions": [
      {
        "version": "1.0",
        "round": 1,
        "date": "2026-10-30",
        "status": "adopted",
        "summary": "Hand-made + physics features, deeper trees",
        "changes": [
          "Adds 11 physics features proposed by the AI: valence electrons per atom and the distance to Matthias's two Tc peaks, d- and p-block shares, light-atom share, an M^-1/2 phonon scale, a stiffness-over-mass proxy, mass ratio, electronegativity spread and packing fraction",
          "Deeper trees: up to 63 leaves (was 31), at least 10 materials per leaf (was 20)"
        ],
        "spec": {
          "inputs": [
            {
              "group": "composition",
              "label": "Composition statistics",
              "n": 34,
              "detail": "mean, spread, min and max of 8 element properties, plus element and site counts"
            },
            {
              "group": "structure",
              "label": "Crystal structure",
              "n": 9,
              "detail": "volume and density, lattice lengths, nearest-neighbour distances"
            },
            {
              "group": "physics",
              "label": "Physics features proposed by the AI",
              "n": 11,
              "items": [
                {
                  "name": "vec",
                  "why": "valence electrons per atom; Matthias found Tc peaks near 4.7 and 6.5 in transition-metal compounds"
                },
                {
                  "name": "matthias_d47",
                  "why": "distance of the valence-electron count from the first Matthias peak (4.7)"
                },
                {
                  "name": "matthias_d65",
                  "why": "distance from the second Matthias peak (6.5)"
                },
                {
                  "name": "d_fraction",
                  "why": "share of d-block atoms, a proxy for a high density of states at the Fermi level"
                },
                {
                  "name": "p_fraction",
                  "why": "share of p-block atoms (covalent bonding, as in MgB2 and the A15 compounds)"
                },
                {
                  "name": "light_fraction",
                  "why": "share of light atoms (Z <= 9), which vibrate at high frequency"
                },
                {
                  "name": "inv_sqrt_mass",
                  "why": "composition average of M^-1/2; phonon frequencies scale like M^-1/2 (isotope effect)"
                },
                {
                  "name": "omega_proxy",
                  "why": "M^-1/2 divided by the mean nearest-neighbour distance, a crude stiffness-over-mass frequency scale"
                },
                {
                  "name": "mass_ratio",
                  "why": "heaviest over lightest atomic mass; light atoms in a heavy matrix give separate optical modes"
                },
                {
                  "name": "x_diff",
                  "why": "electronegativity difference, a proxy for ionicity and charge transfer"
                },
                {
                  "name": "packing_fraction",
                  "why": "atomic-sphere volume over volume per atom, a proxy for how compressed the lattice is"
                }
              ]
            }
          ],
          "learner": {
            "kind": "gradient-boosting",
            "trees": 800,
            "leaves": 63,
            "learning_rate": 0.04,
            "min_leaf": 10,
            "l2": 1.0,
            "features_per_split": 1.0
          },
          "target": "log(1 + Tc)",
          "cv": "5-fold, grouped by chemical system"
        },
