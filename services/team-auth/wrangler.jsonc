{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "supercon-team-auth",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "observability": { "enabled": false },
  "durable_objects": {
    "bindings": [{ "name": "AUTH_STATE", "class_name": "AuthState" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AuthState"] }]
}
