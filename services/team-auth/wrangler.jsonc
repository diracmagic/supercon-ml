{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "supercon-team-auth",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "observability": { "enabled": false },
  "vars": {
    "FIREBASE_PROJECT_ID": "supercon-team",
    "FIREBASE_API_KEY": "AIzaSyBuiEp-ZlMHzulhZPVQ-R79yfmyG93-nVc"
  },
  "durable_objects": {
    "bindings": [{ "name": "AUTH_STATE", "class_name": "AuthState" }, { "name": "TEAM_DIRECTORY", "class_name": "TeamDirectory" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AuthState"] }, { "tag": "v2", "new_sqlite_classes": ["TeamDirectory"] }]
}
